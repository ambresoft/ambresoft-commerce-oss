<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="cms_test" force="true"/>
        <env name="DB_USERNAME" value="cms_test" force="true"/>
        <env name="DB_PASSWORD" value="local-only-test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="ARGON_MEMORY" value="1024" force="true"/>
        <env name="ARGON_TIME" value="1" force="true"/>
        <env name="REDIS_DB" value="14" force="true"/>
        <env name="REDIS_CACHE_DB" value="15" force="true"/>
        <env name="REDIS_PREFIX" value="cms_test_" force="true"/>
        <!-- The Compose "typesense" service; search tests use their own collections and skip when it is not running. -->
        <env name="TYPESENSE_HOST" value="typesense" force="true"/>
        <env name="TYPESENSE_API_KEY" value="local-only-typesense" force="true"/>
    </php>
</phpunit>
