APP_NAME="Ambresoft Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cms
DB_USERNAME=cms
DB_PASSWORD=local-only-cms
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=cms_session
CACHE_STORE=redis
CACHE_PREFIX=cms_cache_
STOREFRONT_CACHE_STORE=storefront
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=cms_
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
# Local only: Mailpit web inbox, shown in the admin next to test emails.
MAIL_LOCAL_INBOX_URL=http://localhost:8025
# Optional local relay of chosen recipients to a real SMTP server (e.g. Gmail with an app password).
# MAILPIT_RELAY_HOST=smtp.gmail.com
# MAILPIT_RELAY_USERNAME=you@gmail.com
# MAILPIT_RELAY_PASSWORD=app-password
# MAILPIT_RELAY_MATCHING=^(you@gmail\\.com|support@example\\.com)$
MAIL_FROM_ADDRESS=hello@cms.test
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_PORT=8025
# Optional local PostgreSQL dashboard. Set a unique password before starting it.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
APP_PORT=8000
VITE_PORT=5173
VITE_APP_NAME="${APP_NAME}"

# Add-ons uploaded from the administration (ZIP). Set false to allow add-on code only through deployment.
ADDON_UPLOADS=true

# Product search (ambresoft/typesense add-on). The Compose service "typesense" answers at http://typesense:8108;
# for an external server set its protocol/host/port (or TYPESENSE_NODES=https://a:443,https://b:443).
# Use a strong, unique API key outside local development; it stays on the server and never reaches the browser.
TYPESENSE_PROTOCOL=http
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=local-only-typesense
TYPESENSE_COLLECTION=products
TYPESENSE_TIMEOUT=3

# Native admin SSE; keep connection slots below the web worker pool size.
ADMIN_SSE_CHECK_SECONDS=3
ADMIN_SSE_HEARTBEAT_SECONDS=10
ADMIN_SSE_LIFETIME_SECONDS=25
ADMIN_SSE_RETRY_MS=10000
ADMIN_SSE_MAX_CONNECTIONS=4

# Optional local GeoLite2/GeoIP2 City database for account-security IP location.
# Leave unset to use storage/app/private/GeoLite2-City.mmdb; private IPs have no location.
# SECURITY_GEOIP_DATABASE=/var/www/html/storage/app/private/GeoLite2-City.mmdb
