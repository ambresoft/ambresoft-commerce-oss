{
  "name": "ambresoft-commerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "types": "tsc --noEmit",
    "lint": "eslint resources/js vite.config.ts vitest.config.ts eslint.config.js modules/ambresoft/sitemap/resources/js",
    "format": "prettier --write resources/js resources/css '*.{json,ts,js}' modules/ambresoft/sitemap/resources/js",
    "format:check": "prettier --check resources/js resources/css '*.{json,ts,js}' modules/ambresoft/sitemap/resources/js",
    "test": "vitest run",
    "check": "pnpm types && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "theme:apply": "node scripts/theme-apply.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@inertiajs/react": "^3.11.0",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extension-youtube": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "dompurify": "^3.4.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@inertiajs/vite": "^3.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.0.0",
    "laravel-vite-plugin": "^3.2.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch@^10": "^11.0.1",
      "undici@>=7 <7.30.1": "^7.30.1",
      "zod@>=4 <4.6.6": "^4.6.6"
    }
  }
}
